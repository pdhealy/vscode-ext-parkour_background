{
  "name": "vscode-ext-parkour-background",
  "displayName": "Parkour Background",
  "description": "Adds a semi-transparent Minecraft or Subway Surfers background image to your VS Code editor.",
  "version": "0.5.1",
  "publisher": "paulhealydev",
  "author": {
    "name": "paulhealy.dev",
    "url": "https://paulhealy.dev"
  },
  "license": "MIT",
  "homepage": "https://github.com/pdhealy/vscode-ext-parkour_background#readme",
  "bugs": {
    "url": "https://github.com/pdhealy/vscode-ext-parkour_background/issues"
  },
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "background",
    "image",
    "minecraft",
    "subway surfers",
    "parkour",
    "fun",
    "personalisation",
    "editor",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pdhealy/vscode-ext-parkour_background.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "backgroundImage.on",
        "title": "Parkour Background: On"
      },
      {
        "command": "backgroundImage.off",
        "title": "Parkour Background: Off"
      },
      {
        "command": "backgroundImage.setOpacity",
        "title": "Parkour Background: Set Opacity"
      },
      {
        "command": "backgroundImage.uninstall",
        "title": "Parkour Background: Uninstall"
      }
    ],
    "configuration": {
      "title": "Parkour Background",
      "properties": {
        "backgroundImage.activeTheme": {
          "type": "string",
          "enum": [
            "none",
            "minecraft",
            "subwaysurfers"
          ],
          "default": "none",
          "description": "The active background image theme. Set to 'minecraft' or 'subwaysurfers' to enable, 'none' to disable."
        },
        "backgroundImage.opacity": {
          "type": "number",
          "default": 0.1,
          "minimum": 0.05,
          "maximum": 0.25,
          "description": "The opacity of the background image (0.05 to 0.25)."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "backgroundImage.on",
          "when": "!backgroundImage.enabled",
          "group": "navigation",
          "title": "Enable Parkour Background"
        },
        {
          "command": "backgroundImage.off",
          "when": "backgroundImage.enabled",
          "group": "navigation",
          "title": "Disable Parkour Background"
        }
      ]
    }
  },
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "vscode:uninstall": "node ./out/uninstall.js",
    "vscode:prepublish": "npm run compile",
    "package": "npm run compile && node node_modules/@vscode/vsce/vsce package",
    "compile": "node node_modules/typescript/bin/tsc -p ./",
    "watch": "node node_modules/typescript/bin/tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "18.x",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^8.57.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "sinon": "^21.0.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "7.0.2"
  }
}
